---
import "../styles/theme.css";
import { ViewTransitions } from "astro:transitions";

interface Props {
    title: string;
    description?: string;
    image?: string;
}

const {
    title,
    description = "jadden picardal: swe and designer",
    image = "https://github.com/jaddenki.png",
} = Astro.props;

const currentPath = Astro.url.pathname;

const navItems = [
    { name: "home", path: "/", icon: "home" },
    { name: "projects", path: "/projects", icon: "bookmark" },
    { name: "about", path: "/about", icon: "smiley" },
    { name: "notebook", path: "/notebook", icon: "notebook" },
];

const isActive = (path: string) => {
    if (path === "/") return currentPath === "/";
    return currentPath.startsWith(path);
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, maximum-scale=5.0"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="manifest" href="/manifest.json" />
        <meta name="theme-color" content="#0000ff" />

        <!-- Preload critical font -->
        <link
            rel="preload"
            href="/fonts/OpeningHoursSans-Regular.woff"
            as="font"
            type="font/woff"
            crossorigin
        />

        <!-- Preconnect to external domains for faster resource loading -->
        <link rel="preconnect" href="https://i.imgur.com" crossorigin />
        <link rel="preconnect" href="https://github.com" crossorigin />
        <link rel="preconnect" href="https://www.youtube.com" crossorigin />
        <link rel="dns-prefetch" href="https://www.are.na" />

        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />

        <!-- Open Graph / Social -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={image} />
        <meta property="og:url" content={Astro.url.href} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={image} />

        <title>{title}</title>

        <!-- View Transitions for smooth page navigations -->
        <ViewTransitions />

        <script
            defer
            src="https://umami.purduehackers.com/script.js"
            data-website-id="4a435137-c59a-4315-8024-4259a3cf4731"></script>
        <!-- Combined inline scripts: Theme initialization + Service Worker -->
        <script is:inline>
            (function () {
                // Theme initialization
                function getEffectiveTheme(storedTheme) {
                    if (
                        storedTheme === "dark" ||
                        storedTheme === "black-sheep"
                    ) {
                        return "black-sheep";
                    }
                    if (!storedTheme) {
                        return window.matchMedia("(prefers-color-scheme: dark)")
                            .matches
                            ? "black-sheep"
                            : "light";
                    }
                    return storedTheme;
                }

                let storedTheme = localStorage.getItem("theme");
                if (storedTheme === "dark") {
                    localStorage.setItem("theme", "black-sheep");
                    storedTheme = "black-sheep";
                }
                if (storedTheme === "auto") {
                    const prefersDark = window.matchMedia(
                        "(prefers-color-scheme: dark)",
                    ).matches;
                    storedTheme = prefersDark ? "black-sheep" : "light";
                    localStorage.setItem("theme", storedTheme);
                }

                const effectiveTheme = getEffectiveTheme(storedTheme);
                document.documentElement.setAttribute(
                    "data-theme",
                    effectiveTheme,
                );

                document.addEventListener("astro:after-swap", () => {
                    const stored = localStorage.getItem("theme");
                    document.documentElement.setAttribute(
                        "data-theme",
                        getEffectiveTheme(stored),
                    );
                });

                // Service Worker registration
                if ("serviceWorker" in navigator) {
                    window.addEventListener("load", () => {
                        navigator.serviceWorker
                            .register("/sw.js")
                            .then((reg) => console.log("SW registered"))
                            .catch((err) =>
                                console.log("SW registration failed:", err),
                            );
                    });
                }
            })();
        </script>
    </head>
    <body>
        <!-- Mobile Hamburger Button -->
        <button class="hamburger-btn" id="hamburger-btn" aria-label="Open menu">
            <span class="hamburger-icon">(=_=)</span>
        </button>

        <!-- Mobile Menu Overlay -->
        <div class="mobile-menu" id="mobile-menu">
            <button
                class="close-btn"
                id="close-menu-btn"
                aria-label="Close menu"
            >
                <span class="close-icon">(x_x)</span>
            </button>
            <div class="mobile-nav-items">
                {
                    navItems.map((item) => (
                        <a
                            href={item.path}
                            class={`mobile-nav-item ${isActive(item.path) ? "mobile-nav-item-active" : ""}`}
                        >
                            <span class="mobile-nav-icon">{item.icon}</span>
                            <span>{item.name}</span>
                        </a>
                    ))
                }
            </div>
        </div>

        <!-- Desktop Horizontal Nav -->
        <nav class="horizontal-nav nav-transitioning" id="horizontal-nav">
            <div class="nav-pill">
                {
                    navItems.map((item) => (
                        <a
                            href={item.path}
                            class={`nav-btn ${isActive(item.path) ? "nav-btn-active" : ""}`}
                            title={item.name}
                        >
                            <span class="nav-icon-wrapper">
                                {item.icon === "home" && (
                                    <svg
                                        class="nav-svg"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                        <polyline points="9 22 9 12 15 12 15 22" />
                                    </svg>
                                )}
                                {item.icon === "notebook" && (
                                    <svg
                                        class="nav-svg"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="M1.28 19.9467C1.28 19.2394 1.56095 18.5611 2.06104 18.061C2.56115 17.561 3.23943 17.28 3.94667 17.28H18.3467M1.28 19.9467C1.28 20.654 1.56095 21.3322 2.06104 21.8323C2.56115 22.3324 3.23943 22.6133 3.94667 22.6133H18.3467V1.27998H3.94667C3.23943 1.27998 2.56115 1.56093 2.06104 2.06102C1.56095 2.56113 1.28 3.23941 1.28 3.94665V19.9467Z" />
                                    </svg>
                                )}
                                {item.icon === "smiley" && (
                                    <svg
                                        class="nav-svg"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <circle cx="12" cy="12" r="10" />
                                        <path d="M8 14s1.5 2 4 2 4-2 4-2" />
                                        <line x1="9" y1="9" x2="9.01" y2="9" />
                                        <line
                                            x1="15"
                                            y1="9"
                                            x2="15.01"
                                            y2="9"
                                        />
                                    </svg>
                                )}
                                {item.icon === "bookmark" && (
                                    <svg
                                        class="nav-svg"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                                    </svg>
                                )}
                            </span>
                            <span class="nav-label">{item.name}</span>
                        </a>
                    ))
                }
            </div>
        </nav>

        <main>
            <slot />
        </main>

        <footer class="footer">
            <div class="content-container footer-content">
                <p class="footer-text">
                    Made with ♡ by <a
                        href="https://github.com/jaddenki/site"
                        target="_blank">Jadden</a
                    > and <a href="https://astro.build" target="_blank">Astro</a
                    >
                </p>
                <div class="theme-toggle-footer">
                    <span class="theme-label">theme:</span>
                    <button
                        id="theme-light"
                        class="theme-option"
                        data-theme="light">light</button
                    >
                    <span class="theme-separator">/</span>
                    <button
                        id="theme-dark"
                        class="theme-option"
                        data-theme="dark">dark</button
                    >
                </div>
            </div>
        </footer>

        <!-- Mobile Menu Toggle Script -->
        <script is:inline>
            function setupMobileMenu() {
                const hamburgerBtn = document.getElementById("hamburger-btn");
                const closeBtn = document.getElementById("close-menu-btn");
                const mobileMenu = document.getElementById("mobile-menu");

                if (hamburgerBtn && closeBtn && mobileMenu) {
                    hamburgerBtn.addEventListener("click", () => {
                        mobileMenu.classList.add("open");
                        document.body.style.overflow = "hidden";
                    });

                    closeBtn.addEventListener("click", () => {
                        mobileMenu.classList.remove("open");
                        document.body.style.overflow = "";
                    });

                    // Close menu when clicking a nav link
                    mobileMenu
                        .querySelectorAll(".mobile-nav-item")
                        .forEach((link) => {
                            link.addEventListener("click", () => {
                                mobileMenu.classList.remove("open");
                                document.body.style.overflow = "";
                            });
                        });
                }
            }

            // Theme toggle
            function setupThemeToggle() {
                function getEffectiveTheme(storedTheme) {
                    if (
                        storedTheme === "dark" ||
                        storedTheme === "black-sheep"
                    ) {
                        return "black-sheep";
                    }
                    // If no stored theme, use user's system preference
                    if (!storedTheme) {
                        return window.matchMedia("(prefers-color-scheme: dark)")
                            .matches
                            ? "black-sheep"
                            : "light";
                    }
                    return storedTheme;
                }

                const setTheme = (theme) => {
                    // Store as "black-sheep" internally but use "dark" for the button
                    const themeToStore =
                        theme === "dark" ? "black-sheep" : theme;
                    localStorage.setItem("theme", themeToStore);
                    document.documentElement.setAttribute(
                        "data-theme",
                        getEffectiveTheme(themeToStore),
                    );
                    updateActiveButton(themeToStore);
                };

                const updateActiveButton = (activeTheme) => {
                    document
                        .querySelectorAll(".theme-option")
                        .forEach((btn) => {
                            const btnTheme = btn.getAttribute("data-theme");
                            // Map "black-sheep" to "dark" for button matching
                            const effectiveTheme =
                                activeTheme === "black-sheep"
                                    ? "dark"
                                    : activeTheme;
                            if (btnTheme === effectiveTheme) {
                                btn.classList.add("active");
                            } else {
                                btn.classList.remove("active");
                            }
                        });
                };

                // Footer theme buttons
                document
                    .getElementById("theme-light")
                    ?.addEventListener("click", () => setTheme("light"));
                document
                    .getElementById("theme-dark")
                    ?.addEventListener("click", () => setTheme("dark"));

                // Set initial active state
                const stored = localStorage.getItem("theme");
                const effectiveTheme =
                    stored ||
                    (window.matchMedia("(prefers-color-scheme: dark)").matches
                        ? "black-sheep"
                        : "light");
                updateActiveButton(effectiveTheme);
            }

            // Smooth navbar label transitions
            function setupNavTransitions() {
                const nav = document.querySelector(".horizontal-nav");
                if (!nav) return;

                const navLinks = nav.querySelectorAll(".nav-btn");

                navLinks.forEach((link) => {
                    link.addEventListener("click", async (e) => {
                        // Don't intercept if already on this page
                        if (link.classList.contains("nav-btn-active")) {
                            e.preventDefault();
                            return;
                        }

                        // Prevent default navigation
                        e.preventDefault();

                        const href = link.getAttribute("href");

                        // Add transitioning class to close all labels
                        nav.classList.add("nav-transitioning");

                        // Wait for close animation
                        await new Promise((resolve) =>
                            setTimeout(resolve, 300),
                        );

                        // Create a temporary link and click it to trigger Astro's view transitions
                        const tempLink = document.createElement("a");
                        tempLink.href = href;
                        tempLink.style.display = "none";
                        document.body.appendChild(tempLink);
                        tempLink.click();
                        document.body.removeChild(tempLink);
                    });
                });
            }

            // Animate label open on page load
            function animateLabelOpen() {
                const nav = document.querySelector(".horizontal-nav");
                if (!nav) return;

                // Wait for browser to finish painting, then animate open
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        nav.classList.remove("nav-transitioning");
                    });
                });
            }

            // Run on initial load
            setupMobileMenu();
            setupThemeToggle();
            setupNavTransitions();
            animateLabelOpen();

            // Re-run after view transitions
            document.addEventListener("astro:after-swap", () => {
                setupMobileMenu();
                setupThemeToggle();
                setupNavTransitions();
                animateLabelOpen();
            });
        </script>
    </body>
</html>

<style is:global>
    /* View Transition Animations - only apply when fully supported */
    @keyframes fade-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @keyframes fade-out {
        from {
            opacity: 1;
        }
        to {
            opacity: 0;
        }
    }

    @keyframes slide-up {
        from {
            transform: translateY(20px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    @keyframes slide-down {
        from {
            transform: translateY(0);
            opacity: 1;
        }
        to {
            transform: translateY(-20px);
            opacity: 0;
        }
    }

    /* Only apply view transitions on browsers with full support (Chrome/Edge) */
    @supports (view-transition-name: none) {
        ::view-transition-old(root) {
            animation: fade-out 0.2s ease-out forwards;
        }

        ::view-transition-new(root) {
            animation: fade-in 0.3s ease-out forwards;
        }

        /* Smooth main content transitions */
        main {
            view-transition-name: main-content;
        }

        ::view-transition-old(main-content) {
            animation: slide-down 0.2s ease-out forwards;
        }

        ::view-transition-new(main-content) {
            animation: slide-up 0.3s ease-out forwards;
        }

        /* Give nav its own view transition that doesn't animate */
        .horizontal-nav {
            view-transition-name: navbar;
        }

        .hamburger-btn {
            view-transition-name: hamburger;
        }

        .mobile-menu {
            view-transition-name: mobile-menu;
        }

        /* Prevent navbar elements from animating during page transitions */
        ::view-transition-old(navbar),
        ::view-transition-old(hamburger),
        ::view-transition-old(mobile-menu),
        ::view-transition-new(navbar),
        ::view-transition-new(hamburger),
        ::view-transition-new(mobile-menu) {
            animation: none !important;
        }

        /* Hide old state instantly */
        ::view-transition-old(navbar),
        ::view-transition-old(hamburger),
        ::view-transition-old(mobile-menu),
        ::view-transition-old(theme-toggle) {
            opacity: 0 !important;
        }
    }

    html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
    }

    body {
        min-height: 100vh;
        font-family: "Opening Hours Sans", sans-serif;
        background-color: var(--background);
        overflow-x: hidden;
        margin: 0;
        padding: 0;
    }

    main {
        position: relative;
    }

    img {
        max-width: 100%;
        height: auto;
    }

    ::selection {
        background-color: var(--accent);
        color: var(--background);
    }

    .horizontal-nav {
        display: flex;
        justify-content: center;
        padding: 1.5rem 1rem;
        z-index: 1000;
    }

    /* Outer pill container */
    .horizontal-nav .nav-pill {
        display: flex;
        align-items: center;
        gap: 6px; /* Space between buttons */
        padding: 8px; /* Inner padding */
        background: var(--background); /* Background color */
        border: 1px solid var(--muted); /* Border */
        border-radius: 32px; /* Pill roundness */
    }

    /* Each nav button */
    .horizontal-nav .nav-btn {
        display: flex;
        align-items: center;
        justify-content: center; /* Center icon horizontally */
        gap: 0; /* No gap when label hidden */
        height: 48px; /* Button height */
        min-width: 48px; /* Min button width */
        padding: 0 12px; /* Left/right padding */
        background: transparent; /* Default: no background */
        border: none;
        border-radius: 16px; /* Button roundness */
        color: var(--secondary); /* Icon/text color */
        text-decoration: none;
        cursor: pointer;
        transition: all 0.3s ease;
        overflow: hidden;
    }

    /* Icon wrapper - ensures icon stays centered */
    .horizontal-nav .nav-icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    /* Hover state */
    .horizontal-nav .nav-btn:hover {
        color: var(--foreground);
        background: var(--muted);
    }

    /* Active state (current page) */
    .horizontal-nav .nav-btn-active {
        background: var(--muted);
        color: var(--foreground);
    }

    /* Dark theme: subtle background on hover/active */
    [data-theme="black-sheep"] .horizontal-nav .nav-btn:hover,
    [data-theme="black-sheep"] .horizontal-nav .nav-btn-active {
        background: rgba(255, 255, 255, 0.08);
    }

    /* Icon size */
    .horizontal-nav .nav-svg {
        width: 24px; /* Icon width */
        height: 24px; /* Icon height */
        flex-shrink: 0;
    }

    /* Label text - hidden by default */
    .horizontal-nav .nav-label {
        font-size: 1rem;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        max-width: 0; /* Collapsed */
        margin-left: 0;
        line-height: 24px; /* Match icon height for vertical centering */
        transition:
            max-width 0.4s ease,
            margin-left 0.4s ease;
    }

    /* Label shown when active */
    .horizontal-nav .nav-btn-active .nav-label {
        max-width: 100px; /* Expanded */
        margin-left: 0.5rem; /* Gap between icon and label */
    }

    /* Add padding when active to accommodate label */
    .horizontal-nav .nav-btn-active {
        padding: 0 16px;
    }

    /* Force labels closed during page transitions */
    .horizontal-nav.nav-transitioning .nav-label {
        max-width: 0 !important;
        margin-left: 0 !important;
    }

    /* First button: extra round on left */
    .horizontal-nav .nav-btn:first-child {
        border-radius: 24px 20px 20px 24px; /* left-top, right-top, right-bottom, left-bottom */
    }

    /* Last button: extra round on right */
    .horizontal-nav .nav-btn:last-child {
        border-radius: 20px 24px 24px 20px;
    }

    /* Hamburger Button - Mobile Only */
    .hamburger-btn {
        display: none;
        position: fixed;
        top: 1rem;
        left: 1rem;
        z-index: 1001;
        background: var(--background);
        border: 1px solid var(--muted);
        border-radius: 12px;
        padding: 0.75rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .hamburger-btn:hover {
        color: var(--accent);
    }

    .hamburger-icon {
        font-size: 1rem;
        color: var(--foreground);
    }

    /* Mobile Menu Overlay */
    .mobile-menu {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: var(--background);
        z-index: 2000;
        flex-direction: column;
        padding: 2rem;
        transform: translateX(-100%);
        transition: transform 0.3s ease;
    }

    .mobile-menu.open {
        transform: translateX(0);
    }

    .close-btn {
        align-self: flex-end;
        background: transparent;
        border: none;
        padding: 0.5rem;
        cursor: pointer;
        color: var(--foreground);
        transition: all 0.2s ease;
    }

    .close-btn:hover {
        color: var(--accent);
    }

    .close-icon {
        font-size: 1.5rem;
    }

    .mobile-nav-items {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 3rem;
    }

    .mobile-nav-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        color: var(--foreground);
        text-decoration: none;
        font-size: 1.25rem;
        padding: 0.75rem;
        border-radius: 12px;
        transition: all 0.2s ease;
    }

    .mobile-nav-item:hover {
        color: var(--accent);
    }

    .mobile-nav-item-active {
        color: var(--accent);
    }

    .mobile-nav-icon {
        font-size: 1rem;
    }

    /* Responsive navigation */
    @media (max-width: 768px) {
        nav.horizontal-nav {
            display: none !important;
        }

        .hamburger-btn {
            display: block;
        }

        .mobile-menu {
            display: flex;
        }
    }

    @media (min-width: 769px) {
        .hamburger-btn,
        .mobile-menu {
            display: none !important;
        }
    }

    /* Footer Styles */
    .footer {
        padding: 3rem 0;
        margin-top: 4rem;
    }

    .footer .content-container {
        max-width: 580px;
        margin: 0 auto;
        padding: 0 1.5rem;
        border-top: 1px solid var(--muted);
        padding-top: 2rem;
    }

    .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .footer-text {
        font-size: 0.938rem;
        color: var(--secondary);
        margin: 0;
    }

    .footer-text a {
        color: var(--foreground);
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .footer-text a:hover {
        color: var(--accent);
    }

    /* Theme Toggle in Footer */
    .theme-toggle-footer {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.875rem;
        color: var(--secondary);
    }

    .theme-label {
        margin-right: 0.25rem;
    }

    .theme-separator {
        color: var(--muted);
    }

    .theme-option {
        background: none;
        border: none;
        padding: 0.125rem 0.25rem;
        color: var(--secondary);
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
        transition: color 0.2s ease;
        border-radius: 4px;
    }

    .theme-option:hover {
        color: var(--foreground);
    }

    .theme-option.active {
        color: var(--foreground);
        font-weight: 500;
    }
</style>
