---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;

// Format date if present
const formattedDate = frontmatter.date ? frontmatter.date : '';

// Determine if this is a notebook/blog post or a project post
const currentPath = Astro.url.pathname;
const isNotebookPost = currentPath.startsWith('/blog/');
const backLink = isNotebookPost ? '/notebook' : '/projects';
const backText = isNotebookPost ? 'back to notebook' : 'back to projects';
---

<Layout title={`${frontmatter.title}`}>
  <div class="post-container">
    <article class="prose">
      <div class="mb-6">
        <a href={backLink} class="inline-flex items-center text-secondary hover:text-accent transition-colors font-['Opening Hours Sans'] text-sm">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          {backText}
        </a>
      </div>
      <header class="mb-8 sm:mb-12">
        <h1 class="text-4xl font-semibold mb-4 font-['Opening Hours Sans']">{frontmatter.title}</h1>
        <div class="text-secondary">
          {formattedDate && (
            <time datetime={formattedDate} class="font-['Opening Hours Sans'] block mb-2">{formattedDate}</time>
          )}
          {frontmatter.description && (
            <div class="font-['Opening Hours Sans'] color-foreground">{frontmatter.description}</div>
          )}
        </div>
      </header>
      <div class="font-['Opening Hours Sans']">
        <slot />
      </div>
    </article>
  </div>
</Layout>

<style is:global>
  .post-container {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .prose {
    font-family: 'Opening Hours Sans', sans-serif;
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--foreground);
  }

  .prose strong {
    color: var(--accent);
  }
  .prose h1 {
    font-family: 'Opening Hours Sans', sans-serif;
    color: var(--foreground);  
  }
  .prose h2 {
    font-family: 'Opening Hours Sans', sans-serif;
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
    color: var(--foreground);
  }

  .prose h3 {
    font-family: 'Opening Hours Sans', sans-serif;
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--accent);
  }

  .prose a {
    color: var(--accent);
    text-decoration: none;
    transition: all 0.2s ease;
    font-family: 'Opening Hours Sans', sans-serif;
  }

  .prose a:hover {
    text-decoration: underline;
  }

  .prose ul {
    list-style-type: none;
    padding-left: 1rem;
  }

  .prose ol {
    padding-left: 1.5rem;
  }

  .prose ul li {
    position: relative;
    margin-bottom: 0.75rem;
    font-family: 'Opening Hours Sans', sans-serif;
  }

  .prose ul li::before {
    content: '';
    position: absolute;
    left: -1rem;
    top: 0.75rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--muted);
  }

  .prose ul li:hover::before {
    background-color: var(--accent);
  }

  .prose ol li {
    margin-bottom: 0.75rem;
    font-family: 'Opening Hours Sans', sans-serif;
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--muted);
    margin: 2rem 0;
  }

  .prose em {
    color: var(--secondary);
    font-style: italic;
    font-family: 'Opening Hours Sans', sans-serif;
  }

  .prose strong {
    color: var(--foreground);
    font-weight: 600;
    font-family: 'Opening Hours Sans', sans-serif;
  }

  .prose img {
    display: block;
    margin: 2.5rem auto;
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    transition: transform 0.2s ease;
  }

  .prose img:hover {
    transform: scale(1.01);
  }

  .prose figure {
    margin: 2.5rem auto;
    text-align: center;
  }

  .prose figcaption {
    margin-top: 0.75rem;
    color: var(--secondary);
    font-size: 0.875rem;
    font-family: 'Opening Hours Sans', sans-serif;
    font-style: italic;
  }

  .prose pre {
    background-color: var(--muted);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    font-family: 'Opening Hours Sans', monospace;
  }

  .prose code {
    font-family: 'Opening Hours Sans', monospace;
    font-size: 0.875em;
    color: var(--accent);
  }
  
  ::selection {
    background-color: var(--accent);
    color: var(--background);
  }

  .prose .footnote-ref {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.875em;
    vertical-align: super;
    line-height: 0;
    margin-left: 0.125rem;
    transition: all 0.2s ease;
  }

  .prose .footnote-ref:hover {
    text-decoration: underline;
  }

  .prose .footnote-back {
    color: var(--accent);
    text-decoration: none;
    margin-left: 0.25rem;
    font-size: 0.875em;
  }

  .prose .footnote-back:hover {
    text-decoration: underline;
  }

  html {
    scroll-behavior: smooth;
  }

  .prose .footnote-item:target {
    background-color: var(--accent-transparent, rgba(0, 0, 255, 0.1));
    padding: 0.5rem;
    border-radius: 0.25rem;
    transition: background-color 0.3s ease;
  }
  
  @media (max-width: 768px) {
    .post-container {
      padding: 0 1rem;
    }
  }

  @media (max-width: 640px) {
    .prose {
      font-size: 1rem;
    }
    
    .prose img {
      margin: 1.5rem auto;
    }
    
    .prose h2 {
      font-size: 1.4rem;
      margin-top: 2rem;
      margin-bottom: 1rem;
    }
    
    .prose h3 {
      font-size: 1.2rem;
      margin-top: 1.5rem;
    }
    
    .prose ul li::before {
      top: 0.6rem;
    }
    
    .prose pre {
      padding: 0.75rem;
      font-size: 0.875rem;
    }
    
    .prose code {
      font-size: 0.875em;
      word-break: break-word;
    }
  }
</style>
