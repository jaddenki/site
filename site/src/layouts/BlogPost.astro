---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
// Format the date nicely
const formattedDate = frontmatter.date ? frontmatter.date : '';
---

<Layout title={`${frontmatter.title}`}>
  <article class="prose px-4 sm:px-6">
    <header class="mb-8 sm:mb-12">
      <h1 class="text-4xl font-semibold mb-4 font-['Syne']">{frontmatter.title}</h1>
      <div class="text-secondary">
        <time datetime={formattedDate} class="font-['Syne']">{formattedDate}</time>
      </div>
    </header>
    <div class="font-['Syne']">
      <slot />
    </div>
  </article>
</Layout>

<style is:global>
  /* Style adjustments for markdown content */
  .prose {
    font-family: 'Syne', sans-serif;
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .prose strong {
    color: var(--accent);
  }


  .prose h2 {
    font-family: 'Syne', sans-serif;
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
    color: var(--foreground);
  }

  .prose h3 {
    font-family: 'Syne', sans-serif;
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--accent);
  }

  .prose a {
    color: var(--accent);
    text-decoration: none;
    transition: all 0.2s ease;
    font-family: 'Syne', sans-serif;
  }

  .prose a:hover {
    text-decoration: underline;
  }

  .prose ul {
    list-style-type: none;
    padding-left: 1rem;
  }

  .prose li {
    position: relative;
    margin-bottom: 0.75rem;
    font-family: 'Syne', sans-serif;
  }

  .prose li::before {
    content: '';
    position: absolute;
    left: -1rem;
    top: 0.75rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--muted);
  }

  .prose li:hover::before {
    background-color: var(--accent);
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--muted);
    margin: 2rem 0;
  }

  .prose em {
    color: var(--secondary);
    font-style: italic;
    font-family: 'Syne', sans-serif;
  }

  .prose strong {
    color: var(--foreground);
    font-weight: 600;
    font-family: 'Syne', sans-serif;
  }

  .prose img {
    display: block;
    margin: 2.5rem auto;
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    transition: transform 0.2s ease;
  }

  .prose img:hover {
    transform: scale(1.01);
  }

  .prose figure {
    margin: 2.5rem auto;
    text-align: center;
  }

  .prose figcaption {
    margin-top: 0.75rem;
    color: var(--secondary);
    font-size: 0.875rem;
    font-family: 'Syne', sans-serif;
    font-style: italic;
  }
  
  /* Add highlighting with accent color */
  ::selection {
    background-color: var(--accent);
    color: var(--background);
  }
  
  /* Mobile optimization */
  @media (max-width: 640px) {
    .prose {
      font-size: 1rem;
    }
    
    .prose img {
      margin: 1.5rem auto;
    }
    
    .prose h2 {
      font-size: 1.4rem;
      margin-top: 2rem;
      margin-bottom: 1rem;
    }
    
    .prose h3 {
      font-size: 1.2rem;
      margin-top: 1.5rem;
    }
    
    .prose li::before {
      top: 0.6rem;
    }
    
    .prose pre {
      padding: 0.75rem;
      font-size: 0.875rem;
      overflow-x: auto;
    }
  }
</style>