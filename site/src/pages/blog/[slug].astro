---
import Layout from '../../layouts/Layout.astro';
import { posts } from '../../data/posts';

export async function getStaticPaths() {
  return posts
    .filter(post => post.published)
    .map(post => {
      const slug = post.link.split('/').pop();
      return {
        params: { slug },
        props: { post }
      };
    });
}

const { post } = Astro.props;
---

<Layout title={`${post.title} · Notebook`}>
  <article class="post-container">
    <header class="post-header">
      <a href="/notebook" class="back-link">
        <svg class="back-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        back to notebook
      </a>
      <time class="post-date">{post.date}</time>
      <h1 class="post-title">{post.title}</h1>
      <p class="post-description">{post.description}</p>
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="post-footer">
      <a href="/notebook" class="back-link">
        ← Back to notebook
      </a>
    </footer>
  </article>
</Layout>

<style>
  .post-container {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }

  .post-header {
    margin-bottom: 3rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--secondary);
    text-decoration: none;
    font-family: 'Opening Hours Sans', sans-serif;
    font-size: 0.875rem;
    transition: color 0.2s ease;
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .back-icon {
    width: 1rem;
    height: 1rem;
  }

  .post-date {
    display: block;
    color: var(--accent);
    font-family: 'Opening Hours Sans', sans-serif;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  .post-title {
    font-family: 'Opening Hours Sans', sans-serif;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 600;
    color: var(--foreground);
    margin: 0 0 1rem 0;
    line-height: 1.2;
  }

  .post-description {
    color: var(--secondary);
    font-family: 'Opening Hours Sans', sans-serif;
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 0;
  }

  .post-footer {
    border-top: 1px solid var(--muted);
    padding-top: 2rem;
    margin-top: 4rem;
  }
</style>

<style is:global>
  .prose {
    font-family: 'Opening Hours Sans', sans-serif;
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--foreground);
  }

  .prose h2 {
    font-family: 'Opening Hours Sans', sans-serif;
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
    color: var(--foreground);
  }

  .prose h3 {
    font-family: 'Opening Hours Sans', sans-serif;
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--accent);
  }

  .prose p {
    margin-bottom: 1.5rem;
  }

  .prose a {
    color: var(--accent);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .prose a:hover {
    text-decoration: underline;
  }

  .prose ul, .prose ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose strong {
    color: var(--foreground);
    font-weight: 600;
  }

  .prose em {
    color: var(--secondary);
    font-style: italic;
  }

  .prose img {
    display: block;
    margin: 2rem auto;
    max-width: 100%;
    border-radius: 0.75rem;
  }

  .prose blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 1.5rem;
    margin: 2rem 0;
    color: var(--secondary);
    font-style: italic;
  }

  .prose code {
    font-family: monospace;
    font-size: 0.9em;
    color: var(--accent);
    background: var(--muted);
    padding: 0.2em 0.4em;
    border-radius: 4px;
  }

  .prose pre {
    background: var(--muted);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .prose pre code {
    background: none;
    padding: 0;
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--muted);
    margin: 2.5rem 0;
  }
</style> 