---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
import Tooltip from '../components/Tooltip';

// Get all published projects, sorted by date
const allProjects = projects
  .filter(project => project.published)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const isVideo = (url: string) => {
  return url.match(/\.(mp4|webm|mov)$/i) !== null;
};
---

<Layout title="projects">
  <div class="max-w-lg mx-auto px-4 sm:px-6 mt-16">
    <!-- Header -->
    <section class="mb-16 sm:mb-20">
      <div class="mb-8 sm:mb-12">
        <h1 class="text-4xl font-semibold font-['Opening Hours Sans']">Projects</h1>
        <p class="text-secondary text-lg font-['Opening Hours Sans'] mt-4">
          Here are some things I've worked on, ranging from case studies to simulations. 
        </p>
      </div>
    </section>
  </div>
</Layout>

<!-- Projects Grid - Full Window Width (Outside Layout component) -->
<section class="mb-32 w-full">
  <div class="projects-grid pl-24 pr-8 sm:pl-28 sm:pr-12 lg:pl-32 lg:pr-16 xl:pl-36 xl:pr-20">
    {allProjects.map((project, index) => (
      <a href={project.link} class="project-card" data-title={project.title}>
        {project.image && (
          <div class="project-image">
            {isVideo(project.image) ? (
              <video
                src={project.image}
                autoplay
                loop
                muted
                playsinline
                class="w-full h-full object-cover"
                preload="metadata"
              />
            ) : (
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
        )}
        
        <h3 class="project-title font-['Opening Hours Sans']">
          {project.title}
        </h3>
        
        <p class="project-description font-['Opening Hours Sans']">
          {project.description}
        </p>
        
        <div class="project-tags">
          {project.tags.slice(0, 3).map(tag => (
            <span class="project-tag font-['Opening Hours Sans']">
              {tag}
            </span>
          ))}
        </div>
      </a>
    ))}
  </div>
  
  <Tooltip client:only="react" />
</section>

<style>
  /* Projects Grid - 4 Column Grid Layout */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    width: 100%;
    max-width: none;
  }
  
  .project-card {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform 0.2s ease;
  }
  
  .project-card:hover {
    transform: translateY(-4px);
  }
  
  /* Project image - 16:9 aspect ratio */
  .project-image {
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 1rem;
  }
  
  .project-image img,
  .project-image video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .project-title {
    font-size: 1.125rem;
    font-weight: 500;
    margin: 0 0 0.5rem 0;
    color: var(--foreground);
  }
  
  .project-description {
    font-size: 0.938rem;
    color: var(--secondary);
    margin: 0 0 0.75rem 0;
    line-height: 1.5;
  }
  
  /* Tags styling */
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .project-tag {
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    border-radius: 999px;
    background-color: var(--muted);
    color: var(--secondary);
    transition: all 0.2s ease;
  }
  
  .project-card:hover .project-tag {
    background-color: var(--accent);
    color: var(--background);
  }
  
  /* Responsive projects grid adjustments */
  @media (max-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }
  
  @media (max-width: 480px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>