---
import Layout from '../layouts/Layout.astro';
import { posts } from '../data/posts';

const sortedPosts = [...posts]
  .filter(post => post.published)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const formatDate = (date: string): string => {
  if (!date) return '';
  if (date.length <= 7) return date;
  return new Date(date).toISOString().split('T')[0];
};
---

<Layout title="jadden's notes">
  <div class="max-w-lg mx-auto px-4 sm:px-6 mt-16">
    <section class="mb-16 sm:mb-20">
      <div class="mb-8 sm:mb-12">
        <h1 class="text-4xl font-normal font-['Opening Hours Sans']">Notebook</h1>
        <p class="text-secondary text-lg font-['Opening Hours Sans'] mt-4">
          What I'm thinking about. For project case studies, check out <a href="/projects" class="text-accent hover:underline">projects</a>.
        </p>
      </div>
    </section>

    <section class="mb-12">
      <div class="grid grid-cols-1 gap-4 mb-8">
        {sortedPosts.map(post => (
          <a href={post.link} class="block group">
            <div class="border border-muted rounded-lg p-3 sm:p-4 transition-all hover:border-accent">
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-1 sm:mb-2">
                <h3 class="font-['Opening Hours Sans'] text-lg sm:text-xl text-foreground group-hover:text-accent transition-colors mb-1 sm:mb-0">
                  {post.title}
                </h3>
                <span class="text-accent font-['Opening Hours Sans'] text-xs whitespace-nowrap sm:ml-4">
                  {formatDate(post.date)}
                </span>
              </div>
              <p class="text-secondary font-['Opening Hours Sans'] text-sm leading-relaxed">
                {post.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>
    
  </div>
</Layout>
