<script>
  // Sync Are.na embed theme with site theme
  function updateArenaTheme() {
    const iframe = document.getElementById('arena-embed') as HTMLIFrameElement | null;
    if (!iframe) return;
    
    const currentTheme = document.documentElement.getAttribute('data-theme');
    const arenaTheme = currentTheme === 'black-sheep' ? 'dark' : 'light';
    const baseUrl = 'https://www.are.na/jadden-picardal/jadden-picardal-4h2pfujye8i/embed';
    
    iframe.src = `${baseUrl}?theme=${arenaTheme}`;
  }
  
  // Update on page load
  updateArenaTheme();
  
  // Watch for theme changes
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.attributeName === 'data-theme') {
        updateArenaTheme();
      }
    });
  });
  
  observer.observe(document.documentElement, { attributes: true });
  
  // Also update after Astro view transitions
  document.addEventListener('astro:after-swap', updateArenaTheme);
</script>

<style>
  /* Content Container - Narrow centered column */
  .content-container {
    max-width: 580px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero Section */
  .hero-section {
    padding: 0 0 2rem;
    margin-bottom: 1rem;
  }

  .hero-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .profile-photo {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--secondary);
    line-height: 1.4;
    margin: 0;
  }

  /* About Section */
  .about-section {
    margin-bottom: 6rem;
  }

  .body-large {
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.5;
    margin: 0 0 2rem 0;
  }

  .body-text {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--secondary);
    margin: 0 0 1.5rem 0;
  }

  .body-text a {
    color: var(--foreground);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .body-text a:hover {
    color: var(--accent);
  }

  .body-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .body-columns .body-text {
    margin: 0;
  }

  /* Links Section */
  .links-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--muted);
  }

  .contact-link {
    display: inline-block;
    font-size: 1.125rem;
    text-decoration: none;
    margin-bottom: 1rem;
    transition: color 0.2s ease;
  }

  .contact-link:hover {
    color: var(--accent);
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .social-link {
    color: var(--secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .social-link:hover {
    color: var(--accent);
  }

  .link-separator {
    color: var(--muted);
  }

  /* Webring */
  .webring-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .webring-link {
    color: var(--secondary);
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
  }

  .webring-link:hover {
    color: var(--accent);
  }

  .webring-icon {
    width: 16px;
    height: 16px;
  }

  .webring-logo .webring-icon {
    width: 20px;
    height: 20px;
  }

  /* Section Styles */
  .section {
    margin-bottom: 6rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 400;
    margin: 0 0 1rem 0;
  }

  .section-intro {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--secondary);
    margin: 0 0 1rem 0;
  }

  /* Video Container */
  .video-container {
    aspect-ratio: 16 / 9;
    background: var(--muted);
    border-radius: 8px;
    overflow: hidden;
  }

  .video-container iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Projects Section - Wider Container */
  .projects-section {
    margin: 6rem 0;
  }

  .projects-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
  }

  .view-all-link {
    color: var(--secondary);
    text-decoration: none;
    font-size: 1rem;
    transition: color 0.2s ease;
  }

  .view-all-link:hover {
    color: var(--accent);
  }

  /* Projects Grid - 3 Columns */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .project-card {
    text-decoration: none;
    color: inherit;
  }

  .project-image {
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .project-image img,
  .project-image video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-title {
    font-size: 1.125rem;
    font-weight: 500;
    margin: 0 0 0.5rem 0;
  }

  .project-description {
    font-size: 0.938rem;
    color: var(--secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* Are.na Section */
  .arena-section {
    margin: 6rem 0;
  }

  .arena-section .section-title {
    margin-bottom: 0.25rem;
  }

  .arena-section .section-header {
    margin-bottom: 0.25rem;
  }

  .arena-section .section-intro {
    margin-bottom: 1rem;
  }

  .arena-embed-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .arena-embed {
    width: 100%;
    height: 600px;
    border: 1px solid var(--muted);
    border-radius: 12px;
    background: var(--background);
  }

  /* Responsive Design */
  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    .content-container,
    .projects-container {
      padding: 0 1rem;
    }

    .hero-section {
      padding: 0 0 1.5rem;
      margin-bottom: 1.5rem;
    }

    .profile-photo {
      width: 64px;
      height: 64px;
    }

    .about-section,
    .section,
    .projects-section,
    .arena-section {
      margin-bottom: 3.5rem;
    }

    .arena-embed-container {
      padding: 0 1rem;
    }

    .arena-embed {
      height: 500px;
    }

    .body-columns {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .body-columns .body-text {
      margin: 0 0 1.5rem 0;
    }

    .body-columns .body-text:last-child {
      margin-bottom: 0;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .hero-section {
      padding: 1.5rem 0 1rem;
      margin-bottom: 2rem;
    }

    .hero-header {
      gap: 1rem;
    }

    .profile-photo {
      width: 56px;
      height: 56px;
    }
  }
</style>
