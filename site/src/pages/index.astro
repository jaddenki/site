---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';

const featuredProjects = projects
  .filter(project => project.published)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3); // Only show 3 projects

const demoReel = {
  description: 'a sneak peek into my experimental and client work',
  videoUrl: 'https://www.youtube.com/embed/X4CYgSqLGf0?si=hetD0C9XLtZ3fOyA&autoplay=1&mute=1&controls=0&loop=1&playlist=X4CYgSqLGf0&playsinline=1',
};

const visualFeed = [
  { type: 'video', src: 'vid/c2.mp4', alt: 'Design exploration 1', size: 'square' },
  { type: 'image', src: 'https://i.imgur.com/iNpueeH.jpeg', alt: 'posterlad inspired photo', size: 'tall' },
  { type: 'image', src: 'https://i.imgur.com/U7a02ck.png', alt: 'Motion study 1', size: 'tall' },
  { type: 'image', src: 'https://i.imgur.com/fQRHoJr.png', alt: 'Brand work', size: 'square' },
  { type: 'video', src: 'vid/dropped.mp4', alt: 'Animation test', size: 'square' },
  { type: 'video', src: 'vid/gyat.mp4', alt: 'Color exploration', size: 'square' },
  { type: 'video', src: '/vid/respell.mp4', alt: 'Interaction demo', size: 'wide' },
  { type: 'image', src: 'https://i.imgur.com/hAgWXUt.png', alt: 'Layout experiment', size: 'square' },
  { type: 'image', src: 'https://i.imgur.com/ktPErR6.png', alt: 'Design system', size: 'wide' },
  { type: 'video', src: 'vid/mbayay_nm6kpg.mp4', alt: 'Prototype demo', size: 'square' },
];

---

<Layout title="jadden picardal">
  <div class="content-container">

    <section class="section mt-16 mb-8">
      <!-- <h2 class="section-title">Motion Reel</h2> -->
      <!-- <p class="section-intro">{demoReel.description}</p> -->
      
      <div class="video-container">
          <iframe
            src={demoReel.videoUrl}
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
    </section>
    
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-header">
          <img 
            src="https://github.com/jaddenki.png" 
            alt="Jadden Picardal" 
          class="profile-photo"
        />
        <div class="hero-text">
          <h1 class="hero-title">Jadden Picardal</h1>
          <p class="hero-subtitle">jaddenpicardal [at] gmail [dot] com</p>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section class="about-section">
      <p class="body-large">
        I design interactive experiences that move with purpose.
      </p>

      <div class="body-columns">
        <p class="body-text">
          I'm a computer engineering student at 
          <a href="https://www.purdue.edu" target="_blank" rel="noopener noreferrer" class="text-foreground font-semibold hover:underline">Purdue</a>, specializing in Computer Systems and Software Engineering. I work with interactive media, motion design, 
          <a href="https://jam.ms" target="_blank" rel="noopener noreferrer" class="text-foreground font-semibold hover:underline">game development</a>, and creative coding, building tools and experiences that feel both playful and purposeful.
        </p>

        <p class="body-text">
I'm currently a Research Software Engineer at the 
<a href="https://envision.center/" target="_blank" rel="noopener noreferrer" class="text-foreground font-semibold hover:underline">Envision Center</a>, working on Mixed Reality development. I also serve as Communications Lead at <a href="https://www.purduehackers.com" target="_blank" rel="noopener noreferrer" class="text-foreground font-semibold hover:underline">Purdue Hackers</a>, helping run creative tech events and celebrate scrappy experimentation.
        </p>
      </div>


      <!-- Contact & Links -->
      <div class="links-section">
        <div class="social-links">
          <a href="https://github.com/jaddenki" target="_blank" rel="noopener noreferrer" class="social-link">
            GitHub
          </a>
          <span class="link-separator">|</span>
          <a href="https://linkedin.com/in/jadden-picardal" target="_blank" rel="noopener noreferrer" class="social-link">
            LinkedIn
          </a>
          <span class="link-separator">|</span>
          <a href="https://curius.app/jadden-picardal" target="_blank" rel="noopener noreferrer" class="social-link">
            Curius
          </a>
          <span class="link-separator">|</span>
          <a href="https://garden.jadden.xyz" target="_blank" rel="noopener noreferrer" class="social-link">
            Garden
          </a>
          <span class="link-separator">|</span>
          <!-- Purdue Hackers Webring -->
          <div class="webring-inline">
            <a href="https://ring.purduehackers.com/previous?host=https://jadden.xyz" class="webring-link" title="Previous site">
              <svg class="webring-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
            </a>
            <a href="https://ring.purduehackers.com/" class="webring-link webring-logo" title="Purdue Hackers Webring">
              <svg class="webring-icon" viewBox="0 0 2625 2625" fill="currentColor">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M875.761 440L1312.5 694.648L1735.55 447.601L1736.81 940.419L1765.64 940.766L1767.14 433.986L2190.66 673.395L2193.53 1691.21L1767.53 1929.43L1767.14 1411.85L1312.5 1676.43V2199.09L873.683 2448.81L435.626 2194.42L437.227 1704.57L882.52 1959.95L895.707 1934.51L453.543 1677.53L876.3 1430.83L875.762 440H875.761Z"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M1325.94 1699.74L1738.95 1938.75L1325.94 1699.74ZM1737.67 1458.72C1737.86 1458.61 1738.09 1458.61 1738.28 1458.72C1738.47 1458.83 1738.58 1459.03 1738.58 1459.24L1738.95 1938.75L1737.37 1460.3L1325.94 1699.74L1738.28 1458.72L1738.95 1938.75L1325.94 1699.74"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M1312.5 664.268L889.076 417.383L1312.31 171.925L1735.55 417.221L1312.5 664.268Z"/>
              </svg>
            </a>
            <a href="https://ring.purduehackers.com/next?host=https://jadden.xyz" class="webring-link" title="Next site">
              <svg class="webring-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Demo Reel Section -->
    <!-- <section class="section">
      <h2 class="section-title">Motion Reel</h2>
      <p class="section-intro">{demoReel.description}</p>
      
      <div class="video-container">
          <iframe
            src={demoReel.videoUrl}
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
    </section> -->
  </div>

  <!-- Projects Section - Wider than content -->
  <section class="projects-section">
    <div class="projects-container">
      <div class="section-header">
        <h2 class="section-title">Selected Projects</h2>
        <a href="/projects" class="view-all-link">View all →</a>
      </div>
      
      <div class="projects-grid">
        {featuredProjects.map(project => (
          <a href={project.link} class="project-card">
            <div class="project-image">
              {project.image && project.image.endsWith('.mp4') ? (
                <video 
                  autoplay
                  loop 
                  muted 
                  playsinline
                  preload="metadata"
                >
                  <source src={project.image} type="video/mp4" />
                </video>
              ) : (
                <img 
                  src={project.image || 'https://via.placeholder.com/400x300'} 
                  alt={project.title}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
            <h3 class="project-title">{project.title}</h3>
            <p class="project-description">{project.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>


</Layout>

<!-- Visual Feed Section - Full Width -->
<section class="visual-feed-section">
  
  <div class="content-container">
    <h2 class="section-title">Visual Feed</h2>
    <p class="section-intro">
        Aside from my software engineering work, I love motion design. Here are some of my personal and client projects.
      </p>  
  </div>
  
  <div class="visual-feed-grid">
    {visualFeed.map((item, index) => (
      <div class={`visual-feed-item visual-feed-item--${item.size}`}>
        {item.type === 'video' ? (
          <video 
            autoplay
            loop 
            muted 
            playsinline
            preload="metadata"
          >
            <source src={item.src} type="video/mp4" />
          </video>
        ) : (
          <img 
            src={item.src} 
            alt={item.alt} 
            loading="lazy"
            decoding="async"
          />
        )}
      </div>
    ))}
  </div>
</section>

<footer class="footer">
  <div class="content-container">
    <p class="footer-text">
      Made with ♡ by <a href="https://github.com/jaddenki/site" target="_blank">Jadden</a> and <a href="https://astro.build" target="_blank">Astro</a>
    </p>
  </div>
</footer>

<style>
  /* Content Container - Narrow centered column */
  .content-container {
    max-width: 580px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero Section */
  .hero-section {
    padding: 0 0 2rem;
    margin-bottom: 3rem;
  }

  .hero-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .profile-photo {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--secondary);
    line-height: 1.4;
    margin: 0;
  }

  /* About Section */
  .about-section {
    margin-bottom: 6rem;
  }

  .body-large {
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.5;
    margin: 0 0 2rem 0;
  }

  .body-text {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--secondary);
    margin: 0 0 1.5rem 0;
  }

  .body-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .body-columns .body-text {
    margin: 0;
  }

  /* Links Section */
  .links-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--muted);
  }

  .contact-link {
    display: inline-block;
    font-size: 1.125rem;
    text-decoration: none;
    margin-bottom: 1rem;
    transition: color 0.2s ease;
  }

  .contact-link:hover {
    color: var(--accent);
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .social-link {
    color: var(--secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .social-link:hover {
    color: var(--accent);
  }

  .link-separator {
    color: var(--muted);
  }

  /* Webring */
  .webring-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .webring-link {
    color: var(--secondary);
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
  }

  .webring-link:hover {
    color: var(--accent);
  }

  .webring-icon {
    width: 16px;
    height: 16px;
  }

  .webring-logo .webring-icon {
    width: 20px;
    height: 20px;
  }

  /* Section Styles */
  .section {
    margin-bottom: 6rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 400;
    margin: 0 0 1rem 0;
  }

  .section-intro {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--secondary);
    margin: 0 0 2rem 0;
  }

  /* Video Container */
  .video-container {
    aspect-ratio: 16 / 9;
    background: var(--muted);
    border-radius: 8px;
    overflow: hidden;
  }

  .video-container iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Projects Section - Wider Container */
  .projects-section {
    margin: 6rem 0;
  }

  .projects-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
  }

  .view-all-link {
    color: var(--secondary);
    text-decoration: none;
    font-size: 1rem;
    transition: color 0.2s ease;
  }

  .view-all-link:hover {
    color: var(--accent);
  }

  /* Projects Grid - 3 Columns */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .project-card {
    text-decoration: none;
    color: inherit;
  }

  .project-image {
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .project-image img,
  .project-image video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-title {
    font-size: 1.125rem;
    font-weight: 500;
    margin: 0 0 0.5rem 0;
  }

  .project-description {
    font-size: 0.938rem;
    color: var(--secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* Visual Feed Section */
  .visual-feed-section {
    margin: 6rem 0;
  }

  .visual-feed-grid {
    columns: 4;
    column-gap: 1rem;
    padding: 0 2rem;
    margin-top: 2rem;
  }
  
  .visual-feed-item {
    background: var(--muted);
    border-radius: 8px;
    overflow: hidden;
    break-inside: avoid;
    margin-bottom: 1rem;
    width: 100%;
  }
  
  .visual-feed-item img,
  .visual-feed-item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .visual-feed-item--square {
    aspect-ratio: 1;
  }
  
  .visual-feed-item--wide {
    aspect-ratio: 2;
  }
  
  .visual-feed-item--tall {
    aspect-ratio: 2/3.16;
  }
  
  /* Footer */
  .footer {
    padding: 3rem 0;
    margin-top: 4rem;
  }

  .footer .content-container {
    border-top: 1px solid var(--muted);
    padding-top: 2rem;
  }

  .footer-text {
    font-size: 0.938rem;
    color: var(--secondary);
    margin: 0;
  }

  .footer-text a {
    color: var(--accent);
    text-decoration: none;
  }

  .footer-text a:hover {
    text-decoration: underline;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .visual-feed-grid {
      columns: 3;
    }
  }

  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    .content-container,
    .projects-container {
      padding: 0 1rem;
    }

    .hero-section {
      padding: 0 0 1.5rem;
      margin-bottom: 1.5rem;
    }

    .profile-photo {
      width: 64px;
      height: 64px;
    }

    .about-section,
    .section,
    .projects-section {
      margin-bottom: 3.5rem;
    }

    .body-columns {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .body-columns .body-text {
      margin: 0 0 1.5rem 0;
    }

    .body-columns .body-text:last-child {
      margin-bottom: 0;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .visual-feed-grid {
      columns: 2;
      padding: 0 1rem;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .hero-section {
      padding: 1.5rem 0 1rem;
      margin-bottom: 2rem;
    }

    .hero-header {
      gap: 1rem;
    }

    .profile-photo {
      width: 56px;
      height: 56px;
    }
  }
</style>
